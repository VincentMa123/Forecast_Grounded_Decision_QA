{
  "category": "flow",
  "rules": [
    {
      "rule_id": "flow_ramp_check",
      "evaluator": "max_abs_step_change",
      "description": "Segment-flow variables should not change beyond the short-time ramp threshold.",
      "priority": 20,
      "selector": {"prefixes": ["B_", "P_"], "suffixes": ["_v001"], "physical_quantities": ["flow"], "roles": ["output"]},
      "limits": {"warning_threshold": 0.35, "fail_threshold": 0.8},
      "flags": {"pass": "flow_ramp_normal", "warning": "flow_ramp_warning", "fail": "flow_ramp_violation"}
    },
    {
      "rule_id": "flow_capacity_check",
      "evaluator": "max_abs_prediction",
      "description": "Flow-like variables are checked against a normalized transmission-capacity limit.",
      "priority": 21,
      "selector": {"prefixes": ["B_", "P_"], "suffixes": ["_v001"], "physical_quantities": ["flow"], "roles": ["output"]},
      "use_registry_limits": true,
      "limits": {"warning_threshold": 2.2, "fail_threshold": 3.0},
      "flags": {"pass": "flow_capacity_normal", "warning": "flow_capacity_warning", "fail": "flow_capacity_violation"}
    },
    {
      "rule_id": "boundary_flow_change_rate",
      "evaluator": "max_abs_step_change",
      "description": "Boundary-flow control proxies should remain within the configured short-time change-rate limit.",
      "priority": 22,
      "selector": {"prefixes": ["T_", "E_"], "suffixes": [":SNQ"], "physical_quantities": ["supply_flow_setpoint", "demand_flow_setpoint"], "roles": ["input"]},
      "limits": {"warning_threshold": 0.35, "fail_threshold": 0.8},
      "flags": {"pass": "boundary_flow_rate_normal", "warning": "boundary_flow_rate_warning", "fail": "boundary_flow_rate_violation"}
    },
    {
      "rule_id": "supply_demand_balance",
      "evaluator": "supply_demand_balance",
      "description": "Detect a widening normalized gap between supply-side and demand-side flow proxies.",
      "priority": 23,
      "supply_selector": {"prefixes": ["T_", "B_"], "suffixes": [":SNQ", "_v001"], "physical_quantities": ["supply_flow_setpoint"], "roles": ["input"]},
      "demand_selector": {"prefixes": ["E_", "P_"], "suffixes": [":SNQ", "_v001"], "physical_quantities": ["demand_flow_setpoint"], "roles": ["input"]},
      "limits": {"warning_threshold": 0.25, "fail_threshold": 0.75},
      "flags": {"pass": "balance_normal", "warning": "balance_warning", "fail": "balance_violation"}
    }
  ],
  "abnormality_warning_rules": [
    {
      "rule_id": "abnormal_pressure_drop",
      "evaluator": "max_step_decline",
      "description": "Review pressure variables for an abnormal one-step pressure drop.",
      "priority": 12,
      "selector": {"prefixes": ["N_", "P_"], "suffixes": ["_v000"], "physical_quantities": ["pressure"], "roles": ["output"]},
      "limits": {"warning_threshold": 0.35, "fail_threshold": 0.8},
      "flags": {"pass": "pressure_drop_normal", "warning": "abnormal_pressure_drop_warning", "fail": "abnormal_pressure_drop_violation"}
    },
    {
      "rule_id": "sudden_flow_change",
      "evaluator": "max_abs_step_change",
      "description": "Review segment-flow variables for sudden short-time changes.",
      "priority": 24,
      "selector": {"prefixes": ["B_", "P_"], "suffixes": ["_v001"], "physical_quantities": ["flow"], "roles": ["output"]},
      "limits": {"warning_threshold": 0.35, "fail_threshold": 0.8},
      "flags": {"pass": "sudden_flow_normal", "warning": "sudden_flow_warning", "fail": "sudden_flow_violation"}
    },
    {
      "rule_id": "equipment_anomaly",
      "evaluator": "max_abs_step_change",
      "description": "Review compressor and power variables for abrupt equipment-state changes.",
      "priority": 53,
      "selector": {"prefixes": ["C_", "TE_"], "suffixes": [], "physical_quantities": ["compressor_load", "compression_ratio", "rotational_speed", "power"], "roles": ["output"]},
      "limits": {"warning_threshold": 0.35, "fail_threshold": 0.8},
      "flags": {"pass": "equipment_state_normal", "warning": "equipment_anomaly_warning", "fail": "equipment_anomaly_violation"}
    },
    {
      "rule_id": "potential_leak_signal",
      "evaluator": "cross_signal_potential_leak",
      "description": "Treat a pressure drop corroborated by sudden flow behavior or a widening supply-demand gap as a potential-leak signal, not a confirmed leak.",
      "priority": 13,
      "supply_selector": {"prefixes": ["T_", "B_"], "suffixes": [":SNQ", "_v001"], "physical_quantities": ["supply_flow_setpoint"], "roles": ["input"]},
      "demand_selector": {"prefixes": ["E_", "P_"], "suffixes": [":SNQ", "_v001"], "physical_quantities": ["demand_flow_setpoint"], "roles": ["input"]},
      "limits": {"warning_gap_threshold": 0.25, "fail_gap_threshold": 0.75},
      "flags": {"pass": "potential_leak_not_detected", "warning": "potential_leak_warning", "fail": "potential_leak_violation"}
    }
  ]
}
