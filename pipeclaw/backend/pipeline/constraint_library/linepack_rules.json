{
  "category": "linepack",
  "rules": [
    {
      "rule_id": "linepack_decline_and_recovery",
      "evaluator": "max_decline_from_start",
      "description": "Linepack should not decline beyond the warning limit and should recover sufficiently.",
      "priority": 30,
      "selector": {"physical_quantities": ["linepack"], "roles": ["output"]},
      "limits": {"warning_threshold": 0.45, "fail_threshold": 1.0},
      "flags": {"pass": "linepack_normal", "warning": "linepack_warning", "fail": "linepack_violation"},
      "minimum_recovery_ratio": 0.5
    },
    {
      "rule_id": "linepack_change_rate",
      "evaluator": "max_abs_step_change",
      "description": "Linepack change rate should remain within the normalized short-time limit.",
      "priority": 31,
      "selector": {"physical_quantities": ["linepack"], "roles": ["output"]},
      "limits": {"warning_threshold": 0.2, "fail_threshold": 0.5},
      "flags": {"pass": "linepack_rate_normal", "warning": "linepack_warning", "fail": "linepack_violation"}
    },
    {
      "rule_id": "linepack_peak_shaving_reserve",
      "evaluator": "minimum_reserve",
      "description": "Linepack should retain configured normalized reserve above the lower safety bound for short-term peak shaving.",
      "priority": 32,
      "selector": {"physical_quantities": ["linepack"], "roles": ["output"]},
      "use_registry_limits": true,
      "limits": {"safe_lower_bound": -3.0, "warning_reserve": 0.5, "fail_reserve": 0.0},
      "flags": {"pass": "linepack_reserve_normal", "warning": "linepack_warning", "fail": "linepack_violation"}
    }
  ]
}
