# OpenAI API 配置
# 复制此文件为 .env 并填入你的配置

# API Key（必需）
OPENAI_API_KEY=sk-your-api-key-here

# API Base URL（可选，用于自定义 API 端点）
# 例如：使用小米 API
# OPENAI_API_BASE=https://api.xiaomimimo.com/v1

# 模型名称（可选）
# OpenAI 官方模型：gpt-4, gpt-3.5-turbo
# 小米模型：mimo-v2-flash, mimo-v2-pro
OPENAI_MODEL=mimo-v2-flash

# 其他可选配置
# OPENAI_TIMEOUT=30
# OPENAI_MAX_RETRIES=3
